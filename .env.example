# ===== Server =====
PORT=3000
BASE_URL=https://gateway.domain.com

# ===== Database =====
DB_PATH=./data/gateway.db

# ===== Admin Dashboard (WAJIB untuk mengaktifkan dashboard admin) =====
# Username & password login dashboard admin (password disimpan ter-hash di DB,
# variabel ini hanya dipakai saat seed pertama kali).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_dengan_password_kuat

# ===== Opsional / Tuning =====
# URL API konversi QRIS pihak ketiga (default sudah terisi)
QRIS_CONVERT_URL=https://qris.miraipedia.my.id/api/convert
QRIS_CONVERT_TIMEOUT_MS=10000
# Batas nominal maksimal (nominal unik tidak andal untuk nominal besar)
MAX_AMOUNT=9999999
# Default lama transaksi valid (menit)
DEFAULT_EXPIRY_MINUTES=15
# Interval background job retry webhook & sweeper expired (ms)
WEBHOOK_RETRY_INTERVAL_MS=30000
EXPIRY_SWEEPER_INTERVAL_MS=60000
# Timeout kirim webhook ke merchant (ms)
WEBHOOK_TIMEOUT_MS=10000
# Maks percobaan kirim webhook (1 awal + 4 retry: 1m, 5m, 30m, 2j)
WEBHOOK_MAX_ATTEMPTS=5

# ===== Session & Keamanan Dashboard =====
# Masa berlaku session login dashboard (default 7 hari)
SESSION_TTL_MS=604800000
# Set true jika di belakang HTTPS (otomatis true saat NODE_ENV=production)
COOKIE_SECURE=false
# Proteksi brute-force login (5 percobaan gagal per 15 menit per user+IP)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
